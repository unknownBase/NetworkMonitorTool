<Window x:Class="NetworkMonitorTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NetworkMonitorTool.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="{Binding WindowTitle}"
        Height="660" Width="1040" MinHeight="520" MinWidth="860"
        WindowStartupLocation="CenterScreen">
    <!-- 主窗口壳：左侧导航 + 右侧内容区 + 顶 / 底栏全局状态（DESIGN 第三节 1、第四节） -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏：应用名 + 全局状态标识（与仪表盘、后续工具条 / 托盘含义一致） -->
        <Border Grid.Row="0" Padding="16,12" Background="#F3F3F3" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedItem.Title, StringFormat=· {0}}"
                               Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.7" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- 告警中醒目标记（DESIGN 第十节），与仪表盘红色横幅含义一致 -->
                    <TextBlock Text="!" Foreground="#C42B1C" FontWeight="Bold" FontSize="16"
                               Margin="0,0,6,0" VerticalAlignment="Center"
                               Visibility="{Binding Status.IsAlerting, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Ellipse Width="12" Height="12" Fill="{Binding Status.StatusBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Status.StatusText}" Margin="6,0,0,0"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Status.LastDetectionText, StringFormat=最近检测 {0}}"
                               Margin="12,0,0,0" Opacity="0.75" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 左导航 + 右内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" MinWidth="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="NavList" Grid.Column="0"
                     ItemsSource="{Binding NavItems}"
                     SelectedItem="{Binding SelectedItem, Mode=OneWay}"
                     SelectionChanged="OnNavSelectionChanged"
                     HorizontalContentAlignment="Stretch"
                     BorderThickness="0,0,1,0" BorderBrush="#E0E0E0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" Padding="4,8" FontSize="14" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ContentControl x:Name="PageHost" Grid.Column="1"
                            Content="{Binding CurrentPage}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Grid>

        <!-- 底栏：延迟 / 连续失败 / 持久化状态（DESIGN 第十四节 3 的界面提示位） -->
        <Border Grid.Row="2" Padding="16,8" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status.LatencyText, StringFormat=延迟 {0}}" />
                    <TextBlock Text="{Binding Status.ConsecutiveFailuresText, StringFormat=连续失败 {0}}"
                               Margin="16,0,0,0" />
                </StackPanel>

                <TextBlock Text="{Binding Status.PersistenceHint}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="#C0392B" FontWeight="SemiBold"
                           Visibility="{Binding Status.PersistenceHint, Converter={StaticResource TextToVisibilityConverter}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
