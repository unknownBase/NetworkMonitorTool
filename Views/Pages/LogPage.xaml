<UserControl x:Class="NetworkMonitorTool.Views.Pages.LogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NetworkMonitorTool.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LogPageViewModel}">
    <!-- 日志页（DESIGN 第四节 2、DESIGN_S16 第八节 2）：状态 / 目标 / 时间筛选、列头排序、导出 CSV、清空（二次确认）、打开日志目录 -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding RetentionHint}" TextWrapping="Wrap" Opacity="0.8" />

        <!-- 筛选与操作条 -->
        <WrapPanel Grid.Row="1" Margin="0,10,0,0" Orientation="Horizontal">
            <TextBlock Text="状态" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox MinWidth="110" VerticalAlignment="Center"
                      ItemsSource="{Binding StatusFilterOptions}"
                      SelectedItem="{Binding SelectedStatusFilter}"
                      DisplayMemberPath="Label" />
            <TextBlock Text="目标" VerticalAlignment="Center" Margin="14,0,6,0" />
            <ComboBox MinWidth="150" VerticalAlignment="Center" MaxWidth="240"
                      ItemsSource="{Binding TargetFilterOptions}"
                      SelectedItem="{Binding SelectedTargetFilter}"
                      DisplayMemberPath="Label"
                      ToolTip="按目标筛选（含已禁用目标，便于查历史）" />
            <TextBlock Text="从" VerticalAlignment="Center" Margin="14,0,6,0" />
            <DatePicker Width="130" VerticalAlignment="Center" SelectedDate="{Binding FromDate}" />
            <TextBlock Text="到" VerticalAlignment="Center" Margin="8,0,6,0" />
            <DatePicker Width="130" VerticalAlignment="Center" SelectedDate="{Binding ToDate}" />
            <Button Content="重置筛选" Padding="10,5" Margin="10,0,0,0" VerticalAlignment="Center"
                    Command="{Binding ResetFilterCommand}" />

            <Button Content="导出 CSV" Padding="10,5" Margin="20,0,0,0" VerticalAlignment="Center"
                    Command="{Binding ExportCsvCommand}"
                    ToolTip="导出当前筛选结果（UTF-8 带 BOM，可用 Excel 打开）" />
            <Button Content="清空" Padding="10,5" Margin="8,0,0,0" VerticalAlignment="Center"
                    Command="{Binding ClearCommand}"
                    ToolTip="清空界面记录与数据库全部目标的检测历史（需确认）" />
            <Button Content="打开日志目录" Padding="10,5" Margin="8,0,0,0" VerticalAlignment="Center"
                    Command="{Binding OpenLogDirectoryCommand}" />
        </WrapPanel>

        <!-- 条数与操作结果 / 行内提示 -->
        <StackPanel Grid.Row="2" Margin="0,8,0,8">
            <TextBlock Text="{Binding CountText}" Opacity="0.8" />
            <TextBlock Text="{Binding TimeRangeError}" Foreground="#C42B1C" TextWrapping="Wrap"
                       Visibility="{Binding TimeRangeError, Converter={StaticResource TextToVisibilityConverter}}" />
            <TextBlock Text="{Binding ActionMessage}" TextWrapping="Wrap" Foreground="#0F6CBD"
                       Visibility="{Binding ActionMessage, Converter={StaticResource TextToVisibilityConverter}}" />
        </StackPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding RecordsView}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserAddRows="False"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Width="170" SortMemberPath="Timestamp"
                                    Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" />
                <DataGridTextColumn Header="目标 IP" Width="140" Binding="{Binding TargetIp}" />
                <DataGridTextColumn Header="Ping" Width="70" SortMemberPath="PingSuccess"
                                    Binding="{Binding PingSuccess, Converter={StaticResource BoolToTextConverter}}" />
                <DataGridTextColumn Header="延迟" Width="90" SortMemberPath="LatencyMs"
                                    Binding="{Binding LatencyMs, StringFormat={}{0} ms, TargetNullValue=—}" />
                <DataGridTextColumn Header="端口" Width="90" SortMemberPath="PortResult"
                                    Binding="{Binding PortResult, Converter={StaticResource PortResultToTextConverter}}" />
                <DataGridTextColumn Header="整体状态" Width="110" SortMemberPath="Status"
                                    Binding="{Binding Status, Converter={StaticResource StatusToTextConverter}}" />
                <DataGridTextColumn Header="错误摘要" Width="*" Binding="{Binding ErrorSummary}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>