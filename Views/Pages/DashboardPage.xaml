<UserControl x:Class="NetworkMonitorTool.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NetworkMonitorTool.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">
    <!-- 仪表盘页（DESIGN 第四节 1）：状态大标识、目标摘要、最近结果、快捷操作、简表跳转 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="1000" HorizontalAlignment="Stretch">

            <!-- 当前状态大标识（颜色 + 文字） -->
            <Border CornerRadius="8" Padding="20,16" Background="{Binding Status.StatusBrush}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status.StatusText}" FontSize="30" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="{Binding Status.ConsecutiveFailuresText, StringFormat=连续失败 {0}}"
                                   Margin="16,0,0,0" FontSize="14" Foreground="White" Opacity="0.9"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Status.LastDetectionText, StringFormat=最近检测：{0}}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="13" Foreground="White" Opacity="0.9" />
                </Grid>
            </Border>

            <!-- 告警中醒目标记（DESIGN 第十节）：红色横幅，恢复成功后随 IsAlerting 复位自动隐藏 -->
            <Border Margin="0,8,0,0" Padding="12,8" CornerRadius="6" Background="#FDE7E9"
                    BorderBrush="#C42B1C" BorderThickness="1"
                    Visibility="{Binding Status.IsAlerting, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Foreground="#C42B1C" FontWeight="SemiBold" TextWrapping="Wrap"
                           Text="{Binding Status.ConsecutiveFailuresText, StringFormat=告警中：连续失败 {0} 次已触发告警，恢复成功后自动重置}" />
            </Border>

            <!-- 目标与检测参数摘要 -->
            <Border Margin="0,16,0,0" Padding="16" CornerRadius="6" Background="#F7F7F9"
                    BorderBrush="#E4E4E7" BorderThickness="1">
                <UniformGrid Rows="2" Columns="4">
                    <StackPanel Margin="0,0,12,12">
                        <TextBlock Text="目标" Opacity="0.65" FontSize="12" />
                        <TextBlock Text="{Binding TargetSummary}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,12">
                        <TextBlock Text="检测间隔" Opacity="0.65" FontSize="12" />
                        <TextBlock Text="{Binding IntervalSummary}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,12">
                        <TextBlock Text="超时时间" Opacity="0.65" FontSize="12" />
                        <TextBlock Text="{Binding TimeoutSummary}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="端口检测策略" Opacity="0.65" FontSize="12" />
                        <TextBlock Text="{Binding PolicySummary}" FontSize="15" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="调度状态" Opacity="0.65" FontSize="12" />
                        <TextBlock Text="{Binding Status.StatusText}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="最近延迟" Opacity="0.65" FontSize="12" />
                        <TextBlock Text="{Binding Status.LatencyText}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="最近检测时间" Opacity="0.65" FontSize="12" />
                        <TextBlock Text="{Binding Status.LastDetectionText}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="连续失败" Opacity="0.65" FontSize="12" />
                        <TextBlock Text="{Binding Status.ConsecutiveFailuresText}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                </UniformGrid>
            </Border>

            <!-- 快捷操作（DESIGN 第四节 1；转为工具条随 S8 窗口形态服务交付） -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="启动" MinWidth="88" Padding="10,6" Command="{Binding StartCommand}" />
                <Button Content="停止" MinWidth="88" Padding="10,6" Margin="8,0,0,0" Command="{Binding StopCommand}" />
                <Button Content="暂停" MinWidth="88" Padding="10,6" Margin="8,0,0,0" Command="{Binding PauseCommand}" />
                <Button Content="恢复" MinWidth="88" Padding="10,6" Margin="8,0,0,0" Command="{Binding ResumeCommand}" />
                <Button Content="转为工具条" MinWidth="104" Padding="10,6" Margin="8,0,0,0"
                        Command="{Binding SwitchToToolbarCommand}"
                        ToolTip="隐藏主窗口，显示无边框紧凑工具条（双击或右键可恢复）" />
            </StackPanel>

            <!-- 最近记录简表（只读预览，可跳转日志页） -->
            <Grid Margin="0,20,0,0">
                <TextBlock Text="最近记录" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Content="查看全部记录" HorizontalAlignment="Right" Padding="10,4"
                        Command="{Binding NavigateToLogCommand}" />
            </Grid>

            <DataGrid Margin="0,8,0,0" Height="240"
                      ItemsSource="{Binding RecentRecords}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Width="150"
                                        Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" />
                    <DataGridTextColumn Header="目标" Width="140" Binding="{Binding TargetIp}" />
                    <DataGridTextColumn Header="Ping" Width="70"
                                        Binding="{Binding PingSuccess, Converter={StaticResource BoolToTextConverter}}" />
                    <DataGridTextColumn Header="延迟" Width="80"
                                        Binding="{Binding LatencyMs, StringFormat={}{0} ms, TargetNullValue=—}" />
                    <DataGridTextColumn Header="端口" Width="80"
                                        Binding="{Binding PortResult, Converter={StaticResource PortResultToTextConverter}}" />
                    <DataGridTextColumn Header="状态" Width="100"
                                        Binding="{Binding Status, Converter={StaticResource StatusToTextConverter}}" />
                    <DataGridTextColumn Header="错误摘要" Width="*" Binding="{Binding ErrorSummary}" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
