<UserControl x:Class="NetworkMonitorTool.Views.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NetworkMonitorTool.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}">
    <!-- 关于页（DESIGN 第四节 5）：版本、配置 / 数据库 / 日志位置、使用说明入口 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="820" HorizontalAlignment="Stretch">

            <TextBlock Text="{Binding ProductName}" FontSize="20" FontWeight="Bold" />
            <TextBlock Margin="0,4,0,0" Text="{Binding VersionText, StringFormat=版本 {0}}" Opacity="0.8" />

            <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0,20,0,8" Text="文件位置" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="配置文件" />
                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource PathBoxStyle}" Text="{Binding ConfigPath, Mode=OneWay}" />
                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource OpenDirButtonStyle}"
                        Content="打开" Command="{Binding OpenConfigDirectoryCommand}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="数据库" />
                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource PathBoxStyle}" Text="{Binding DatabasePath, Mode=OneWay}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="日志目录" />
                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource PathBoxStyle}" Text="{Binding LogDirectoryPath, Mode=OneWay}" />
                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource OpenDirButtonStyle}"
                        Content="打开" Command="{Binding OpenLogDirectoryCommand}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="错误日志" />
                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource PathBoxStyle}" Text="{Binding ErrorLogPath, Mode=OneWay}" />
            </Grid>

            <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0,20,0,8" Text="运行状态" />
            <StackPanel>
                <TextBlock Text="{Binding DataDirectoryState, StringFormat=数据目录：{0}}" />
                <TextBlock Margin="0,4,0,0" Text="{Binding PersistenceState}" />
            </StackPanel>

            <Button Margin="0,12,0,0" HorizontalAlignment="Left" Padding="10,4"
                    Content="打开数据目录" Command="{Binding OpenDataDirectoryCommand}" />

            <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0,20,0,8" Text="使用说明" />
            <Border Padding="12" CornerRadius="4" Background="#F7F7F9" BorderBrush="#E4E4E7" BorderThickness="1">
                <TextBlock Text="{Binding UsageGuide}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
