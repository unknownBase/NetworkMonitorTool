<UserControl x:Class="NetworkMonitorTool.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NetworkMonitorTool.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <!-- 设置页（DESIGN 第四节 4）：六组分区 + 底部保存 / 恢复默认 / 取消，校验失败行内提示 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,20,20,8" MaxWidth="780" HorizontalAlignment="Stretch">

                <!-- a) 目标设置 -->
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="a) 目标设置" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="目标 IP / 主机名" />
                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <TextBox Style="{StaticResource InputBoxStyle}" Text="{Binding TargetIp, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource InlineErrorStyle}" Text="{Binding TargetIpError}" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="端口（可空）" />
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBox Style="{StaticResource InputBoxStyle}" Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource HintTextStyle}" Text="留空表示不检测端口" />
                        <TextBlock Style="{StaticResource InlineErrorStyle}" Text="{Binding PortError}" />
                    </StackPanel>
                </Grid>

                <!-- b) 检测设置 -->
                <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0,22,0,0" Text="b) 检测设置" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="检测间隔（时 / 分 / 秒）" />
                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="64" Padding="6,4" Text="{Binding IntervalHoursText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="时" Margin="4,0,12,0" VerticalAlignment="Center" />
                            <TextBox Width="64" Padding="6,4" Text="{Binding IntervalMinutesText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="分" Margin="4,0,12,0" VerticalAlignment="Center" />
                            <TextBox Width="64" Padding="6,4" Text="{Binding IntervalSecondsText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="秒" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource HintTextStyle}" Text="总时长须大于 0；运行中保存后按新间隔重启调度周期" />
                        <TextBlock Style="{StaticResource InlineErrorStyle}" Text="{Binding IntervalError}" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="超时时间（毫秒）" />
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBox Style="{StaticResource InputBoxStyle}" Text="{Binding TimeoutMsText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource InlineErrorStyle}" Text="{Binding TimeoutError}" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="端口检测策略" />
                    <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" MinWidth="220"
                              ItemsSource="{Binding PortPolicyOptions}"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding PortPolicy}"
                              DisplayMemberPath="Label" />
                </Grid>

                <!-- c) 告警设置 -->
                <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0,22,0,0" Text="c) 告警设置" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="连续失败告警阈值" />
                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <TextBox Style="{StaticResource InputBoxStyle}" Text="{Binding ThresholdText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource InlineErrorStyle}" Text="{Binding ThresholdError}" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="告警方式与计数" />
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <CheckBox Content="应用内弹窗" Margin="0,4" IsChecked="{Binding PopupEnabled}" />
                        <CheckBox Content="托盘通知" Margin="0,4" IsChecked="{Binding TrayNotifyEnabled}" />
                        <CheckBox Content="将「端口失败」单独计入连续失败" Margin="0,4" IsChecked="{Binding CountPortFailure}" />
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Text="告警触发与展示在 S6 / S7 交付，本迭代仅保存配置" />
                    </StackPanel>
                </Grid>

                <!-- d) 存储设置 -->
                <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0,22,0,0" Text="d) 存储设置" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="历史保留天数" />
                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <TextBox Style="{StaticResource InputBoxStyle}" Text="{Binding RetentionDaysText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource InlineErrorStyle}" Text="{Binding RetentionDaysError}" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="内存最大条数" />
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBox Style="{StaticResource InputBoxStyle}" Text="{Binding MaxInMemoryText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource InlineErrorStyle}" Text="{Binding MaxInMemoryError}" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="数据目录" />
                    <StackPanel Grid.Row="2" Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="330" Padding="6,4" VerticalAlignment="Center"
                                     Text="{Binding DataDirectory, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Margin="8,0,0,0" Padding="10,4" Content="选择…"
                                    Command="{Binding BrowseDataDirectoryCommand}" />
                            <Button Margin="6,0,0,0" Padding="10,4" Content="用默认目录"
                                    Command="{Binding ResetDataDirectoryToDefaultCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource HintTextStyle}" Text="{Binding DataDirectoryHint}" />
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Text="保存时先将数据库与日志迁移到新目录，验证成功后才切换；失败保持原目录且不丢数据" />
                        <TextBlock Style="{StaticResource InlineErrorStyle}" Text="{Binding DataDirectoryError}" />
                    </StackPanel>
                </Grid>

                <!-- e) 界面设置 -->
                <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0,22,0,0" Text="e) 界面设置" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="关闭主窗口时" />
                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <ComboBox HorizontalAlignment="Left" MinWidth="220"
                                  ItemsSource="{Binding CloseBehaviorOptions}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding CloseMainWindowBehavior}"
                                  DisplayMemberPath="Label" />
                        <CheckBox Content="工具条置顶" Margin="0,8,0,4" IsChecked="{Binding ToolbarTopMost}" />
                        <CheckBox Content="最小化时自动转为工具条" Margin="0,0,0,4"
                                  IsChecked="{Binding ToolbarAutoOnMinimize}" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="生效说明" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource HintTextStyle}"
                               VerticalAlignment="Top" Text="{Binding DeferredHint}" />
                </Grid>

                <!-- f) 启动设置 -->
                <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0,22,0,0" Text="f) 启动设置" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="开机自启" />
                    <StackPanel Grid.Column="1">
                        <CheckBox Content="登录 Windows 后自动启动" Margin="0,4" IsChecked="{Binding AutoStartEnabled}" />
                        <CheckBox Content="自启后直接进入工具条形态" Margin="0,4" IsChecked="{Binding AutoStartInToolbar}" />
                        <TextBlock Style="{StaticResource HintTextStyle}" Text="自启项写入 / 移除在 S10 交付，当前仅保存配置" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作条：保存后生效，取消放弃草稿（DESIGN 第五节 2） -->
        <Border Grid.Row="1" Padding="20,12" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="保存" MinWidth="92" Padding="10,6" Command="{Binding SaveCommand}" />
                    <Button Content="恢复默认" MinWidth="92" Padding="10,6" Margin="8,0,0,0"
                            Command="{Binding RestoreDefaultCommand}" />
                    <Button Content="取消" MinWidth="92" Padding="10,6" Margin="8,0,0,0" Command="{Binding CancelCommand}" />
                    <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                               Text="{Binding SaveMessage}" />
                </StackPanel>

                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.7"
                           Text="存在未保存修改"
                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
