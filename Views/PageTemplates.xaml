<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:NetworkMonitorTool.Converters"
                    xmlns:vm="clr-namespace:NetworkMonitorTool.ViewModels"
                    xmlns:pages="clr-namespace:NetworkMonitorTool.Views.Pages">

    <!-- 状态 → 颜色 / 文案等共用转换器（DESIGN 第二节 5、第十节） -->
    <conv:DetectionStatusToBrushConverter x:Key="StatusToBrushConverter" />
    <conv:DetectionStatusToTextConverter x:Key="StatusToTextConverter" />
    <conv:PortProbeStatusToTextConverter x:Key="PortResultToTextConverter" />
    <conv:AlertDeliveryMethodsToTextConverter x:Key="AlertDeliveryToTextConverter" />
    <conv:BoolToTextConverter x:Key="BoolToTextConverter" />
    <conv:TextToVisibilityConverter x:Key="TextToVisibilityConverter" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <!-- 页面共用样式（S4）：设置页 / 关于页的标签、输入框与行内校验提示 -->
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <Style x:Key="InputBoxStyle" TargetType="TextBox">
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Padding" Value="6,4" />
    </Style>

    <Style x:Key="PathBoxStyle" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Margin" Value="0,2,8,2" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="InlineErrorStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#C0392B" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Visibility">
            <Setter.Value>
                <!-- 空文案自动收起，无需每处手写触发器 -->
                <Binding RelativeSource="{RelativeSource Self}" Path="Text"
                         Converter="{StaticResource TextToVisibilityConverter}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HintTextStyle" TargetType="TextBlock">
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OpenDirButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- ViewModel 优先导航：内容区按页面视图模型映射到视图（S4 页面框架） -->
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <pages:DashboardPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:LogPageViewModel}">
        <pages:LogPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AlertHistoryViewModel}">
        <pages:AlertHistoryPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <pages:SettingsPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AboutViewModel}">
        <pages:AboutPage />
    </DataTemplate>
</ResourceDictionary>
